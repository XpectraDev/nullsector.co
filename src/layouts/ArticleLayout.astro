---
import BaseLayout from './BaseLayout.astro';
import { SITE, PERSON } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'investigacion'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags } = entry.data;
const url = new URL(`/investigacion/${entry.id}/`, SITE.url).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: 'es',
    author: {
      '@type': 'Person',
      '@id': `${SITE.url}/#miguel-zabala`,
      name: author,
      url: `${SITE.url}/miguel-zabala/`,
    },
    publisher: { '@id': `${SITE.url}/#miguel-zabala` },
    mainEntityOfPage: url,
    keywords: tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Investigación', item: `${SITE.url}/investigacion/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${title} | ${SITE.name}`} description={description} type="article" structuredData={structuredData}>
  <article class="section">
    <div class="container prose">
      <p class="eyebrow">Investigación</p>
      <h1>{title}</h1>
      <p class="muted">
        Por <a href="/miguel-zabala/">{author}</a> · {fmt(pubDate)}
        {updatedDate ? ` · actualizado ${fmt(updatedDate)}` : ''}
      </p>
      <slot />
    </div>
  </article>
</BaseLayout>
