---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada (404) | Nullsector" description="La página que buscas no existe o se movió.">
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Página no encontrada</h1>
      <p class="lead">El recurso que buscas no existe o cambió de sitio.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Volver al inicio</a>
        <a class="btn btn-ghost" href="/investigacion/">Ver investigación</a>
      </div>
    </div>
  </section>
</BaseLayout>
