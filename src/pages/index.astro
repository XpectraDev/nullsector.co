---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PERSON, ORG, EXPERIENCE, SKILLS, INDUSTRIES, CREDENTIALS } from '../consts';

const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#miguel-zabala`,
  name: PERSON.name,
  alternateName: PERSON.alternateName,
  jobTitle: PERSON.jobTitle,
  description: PERSON.positioning,
  url: SITE.url,
  email: `mailto:${PERSON.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
  worksFor: { '@type': 'Organization', name: ORG.name, url: ORG.url },
  knowsAbout: PERSON.knowsAbout,
  sameAs: PERSON.sameAs,
  hasCredential: CREDENTIALS.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: `${c.code}: ${c.name}`, credentialCategory: 'certification', url: PERSON.credentialUrl })),
};
const structuredData = [
  { '@context': 'https://schema.org', ...person },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.name, inLanguage: 'es', publisher: { '@id': `${SITE.url}/#miguel-zabala` } },
  { '@context': 'https://schema.org', '@type': 'ProfilePage', '@id': `${SITE.url}/#profilepage`, url: SITE.url, mainEntity: { '@id': `${SITE.url}/#miguel-zabala` } },
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${ORG.url}/#organization`, name: ORG.name, url: ORG.url, description: ORG.description, founder: { '@id': `${SITE.url}/#miguel-zabala` } },
];

const featured = [
  { href: '/investigacion/rgs-tool/', title: 'RGS Tool', desc: 'Generación automatizada de informes de seguridad con IA. Reconocida por NVIDIA en su concurso de agentes con LangChain.', meta: 'Mención NVIDIA' },
  { href: '/investigacion/spectra/', title: 'SPECTRA', desc: 'LLMs y emulación de adversarios. La investigación que se convirtió en Xpectra.ai.', meta: 'I+D · 2024' },
  { href: '/investigacion/la-doble-fuerza-de-la-auditoria-web-combinando-tacticas-manuales-y-automaticas/', title: 'La doble fuerza de la auditoría web', desc: 'Combinar tácticas manuales y automáticas para encontrar lo que cada una pasa por alto.', meta: 'Writeup' },
  { href: '/investigacion/cve-2023-22518-vulnerabilidad-critica-en-confluence/', title: 'CVE-2023-22518 en Confluence', desc: 'Anatomía de una vulnerabilidad crítica y su explotación.', meta: 'CVE' },
];

const certLine = CREDENTIALS.map((c) => c.code).join(' · ');
---
<BaseLayout title={SITE.title} description={SITE.description} type="profile" structuredData={structuredData}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Investigador de seguridad ofensiva</p>
        <h1>Rompo sistemas para entenderlos. Después construyo la IA que los defiende.</h1>
        <p class="lead">Nueve años de pentesting, exploit development y red team en banca, gobierno, aeronáutica y entornos OT, en Colombia, España y Dinamarca. Fundador de <a href="/xpectra/">Xpectra</a>.</p>
        <div class="hero-links">
          <a href="/investigacion/">Investigación →</a>
          <a href="/xpectra/">Xpectra →</a>
          <a href="https://github.com/MangelZabalaDevelop" rel="noopener">GitHub →</a>
          <a href={`mailto:${PERSON.email}`}>Contacto →</a>
        </div>
      </div>
      <aside class="vcard" aria-label="Ficha de Miguel Zabala">
        <div class="row"><span class="k">whoami</span><span class="v">Miguel Zabala</span></div>
        <div class="row"><span class="k">rol</span><span class="v">Pentester · Investigador</span></div>
        <div class="row"><span class="k">base</span><span class="v">Bogotá, Colombia</span></div>
        <div class="row"><span class="k">foco</span><span class="v">Ofensiva + IA generativa</span></div>
        <div class="row"><span class="k">empresa</span><span class="v">Xpectra.ai</span></div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="sec-label"><span class="n">01</span> Trabajo seleccionado</p>
      <ol class="worklist">
        {featured.map((w, i) => (
          <li><a href={w.href}>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{w.title}</h3><p>{w.desc}</p></div>
            <span class="meta">{w.meta}</span>
          </a></li>
        ))}
      </ol>
      <p class="mono" style="margin-top:1.7rem"><a href="/investigacion/">Ver toda la investigación →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="sec-label"><span class="n">02</span> Trayectoria</p>
      <div class="timeline">
        {EXPERIENCE.map((e) => (
          <div class="tl">
            <div class="when">{e.period}</div>
            <div>
              <div class="role">{e.role} <span class="muted">·</span> <span class="org">{e.org}</span></div>
              <div class="place">{e.place}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="sec-label"><span class="n">03</span> Qué hago</p>
      <div class="chips">{SKILLS.map((s) => <span class="chip">{s}</span>)}</div>
      <p class="certline" style="margin-top:1.7rem">Certificaciones: <strong>{certLine}</strong>. <a href={PERSON.credentialUrl} rel="noopener">Verificables ↗</a></p>
      <p class="muted" style="margin-top:0.5rem">Sectores auditados: {INDUSTRIES.join(' · ')}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="sec-label"><span class="n">04</span> Xpectra</p>
      <p class="lead" style="max-width:60ch">{ORG.description}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={ORG.url} rel="noopener">Visitar Xpectra</a>
        <a class="btn" href="/xpectra/">La tesis, desde el fundador</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="sec-label"><span class="n">05</span> Contacto</p>
      <h2>Hablemos</h2>
      <p class="muted" style="margin-top:0.6rem">¿Un proyecto de seguridad ofensiva o IA aplicada? Escríbeme.</p>
      <div class="hero-links" style="margin-top:1.2rem">
        <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
        <a href="https://www.linkedin.com/in/miguelzabalap" rel="noopener">LinkedIn →</a>
        <a href="https://github.com/MangelZabalaDevelop" rel="noopener">GitHub →</a>
      </div>
    </div>
  </section>
</BaseLayout>
