---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PERSON, ORG, CREDENTIALS, EXPERIENCE, SKILLS, INDUSTRIES, LANGUAGES } from '../consts';

const url = `${SITE.url}/miguel-zabala/`;
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'ProfilePage', '@id': `${url}#profilepage`, url, inLanguage: 'es', mainEntity: { '@id': `${SITE.url}/#miguel-zabala` } },
  {
    '@context': 'https://schema.org', '@type': 'Person', '@id': `${SITE.url}/#miguel-zabala`,
    name: PERSON.name, alternateName: PERSON.alternateName, jobTitle: PERSON.jobTitle, description: PERSON.positioning,
    url: SITE.url, email: `mailto:${PERSON.email}`,
    address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
    worksFor: { '@type': 'Organization', name: ORG.name, url: ORG.url },
    knowsAbout: PERSON.knowsAbout, sameAs: PERSON.sameAs,
    hasCredential: CREDENTIALS.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: `${c.code}: ${c.name}`, credentialCategory: 'certification', url: PERSON.credentialUrl })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Miguel Zabala', item: url },
  ] },
];
---
<BaseLayout
  title="Miguel Zabala, perfil oficial | OSCE³ e investigador de seguridad ofensiva"
  description="Perfil oficial de Miguel Zabala: OSCE³, 9 años en seguridad ofensiva (Aiuken, CSIS, Mnemo), pentesting, exploit development e IA generativa. Fundador de Xpectra."
  type="profile"
  structuredData={structuredData}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Perfil oficial</p>
      <h1><span class="gold">Miguel Zabala</span></h1>
      <p class="lead"><span class="lead-strong">{PERSON.headline}.</span> {PERSON.positioning}</p>
      <p class="muted" style="margin-top:0.8rem">{PERSON.location} · <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a></p>
      <div class="btn-row">
        <a class="btn btn-primary" href={PERSON.credentialUrl} rel="noopener">Verificar credenciales</a>
        <a class="btn btn-ghost" href="https://github.com/MangelZabalaDevelop" rel="noopener">GitHub</a>
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/miguelzabalap" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Certificaciones verificables</p>
      <div class="certs">
        {CREDENTIALS.filter((c) => c.file).map((c) => (
          <img src={c.file} alt={`${c.code}: ${c.name}`} title={`${c.code}: ${c.name}`} height="92" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Sobre mí</h2>
      <p>Soy investigador de seguridad ofensiva con 9 años de experiencia. Actualmente trabajo como Penetration Tester en Aiuken Cybersecurity. Mi recorrido abarca sectores críticos en Colombia, España y Dinamarca.</p>
      <p>Mi credencial central es <a href="/osce3/">OSCE³</a>, el nivel experto de OffSec, que reúne <a href="/osce3/osed/">OSED</a>, <a href="/osce3/osep/">OSEP</a> y <a href="/osce3/oswe/">OSWE</a>. Además cuento con OSCP, OSWP y CEHv9.</p>
      <p>Fundé <a href={ORG.url} rel="noopener">Xpectra</a> para llevar esa experiencia ofensiva a agentes de IA que analizan, validan y documentan riesgos con procesamiento local y privacidad.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Trayectoria</p>
      <h2>Experiencia profesional</h2>
      <div class="timeline">
        {EXPERIENCE.map((e) => (
          <div class="tl">
            <div class="role">{e.role} <span class="muted">·</span> <span class="org">{e.org}</span></div>
            <div class="meta">{e.place} · {e.period}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <p class="eyebrow">Especialidades</p>
          <div class="chips">{SKILLS.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
        <div>
          <p class="eyebrow">Sectores auditados</p>
          <div class="chips">{INDUSTRIES.map((s) => <span class="chip">{s}</span>)}</div>
          <p class="eyebrow" style="margin-top:1.6rem">Idiomas</p>
          <div class="chips">{LANGUAGES.map((l) => <span class="chip">{l.lang}: {l.level}</span>)}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Proyectos destacados</p>
      <div class="grid grid-2" style="margin-top:1.4rem">
        <a class="card" href="/investigacion/rgs-tool/">
          <span class="tag">Mención honorable · NVIDIA</span>
          <h3>RGS Tool</h3>
          <p class="muted">Generación automatizada de informes de seguridad con IA.</p>
        </a>
        <a class="card" href="/investigacion/spectra/">
          <span class="tag">El origen de Xpectra</span>
          <h3>SPECTRA</h3>
          <p class="muted">LLMs y emulación de adversarios. La investigación que se convirtió en Xpectra.ai.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
